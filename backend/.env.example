# FiForesight backend environment variables
# Copy to backend/.env and fill in the values you need.

# --- LLM Analyst Jury (required for jury verdicts) ---
GROQ_API_KEY=
# Jury auto-run. OFF by default: /predict only caches the market context and
# the jury runs on demand via POST /jury/reanalyze (the "Run jury" button) —
# saves Groq free-tier quota and avoids 429 fallback verdicts in predictions.
# Set true to restore the legacy behaviour (jury runs on every prediction).
JURY_AUTO_RUN=false

# --- InfluxDB (OHLCV cache / simulation state) ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=WeekendDevelopment
INFLUXDB_BUCKET=FiForesightBucket

# --- News / sentiment (optional) ---
SERP_API_KEY=
FINNHUB_API_KEY=

# --- IPO calendar ---
# No key needed: the IPO Tracker uses the free Nasdaq IPO calendar, falling back
# to the keyless SEC EDGAR S-1 feed if Nasdaq is unreachable.
# StockTwits social sentiment. The public API now returns 403 without auth, so
# this is OFF by default — leave unset unless you wire up an authenticated source.
STOCKTWITS_ENABLED=false

# --- Order Book / Market Depth ---
# Crypto pairs (e.g. BTC-USD) return genuine Level-2 depth from Coinbase's
# free public API — no key required, works out of the box.
#
# Stocks (e.g. NVDA) use Alpaca's free IEX top-of-book (Level 1). This needs a
# free API key (the plain Key ID + Secret from the dashboard — NOT OAuth).
# Create a free account at https://alpaca.markets, then under Paper Trading →
# "API Keys" generate a key. When unset, GET /orderbook/{stock} returns 503,
# but crypto pairs still work.
# Key ID from app.alpaca.markets (paper trading)
ALPACA_API_KEY=
# Secret key from app.alpaca.markets (paper trading)
ALPACA_SECRET_KEY=

# --- Deployment environment ---
# Stamped as the `env` tag on time-series writes (e.g. sentiment_score) so
# preview and prod data can be told apart in InfluxDB. local | preview | live.
APP_ENV=local

# --- Auth ---
# Supabase issues ES256 (asymmetric) access tokens by default for projects with
# JWT signing keys. Set SUPABASE_URL so the backend can verify them against the
# project JWKS — the legacy HS256 secret below CANNOT verify ES256 tokens.
SUPABASE_URL=https://your-project.supabase.co
# Optional explicit JWKS override (defaults to SUPABASE_URL + the standard path).
# SUPABASE_JWKS_URL=
# Legacy HS256 JWT secret (Settings → API → JWT Secret). Only needed for
# projects still issuing HS256 tokens. When neither SUPABASE_URL nor this is set,
# tokens are decoded without verification only if ALLOW_INSECURE_JWT=true.
SUPABASE_JWT_SECRET=

# --- CORS ---
# Comma-separated list of origins the API accepts. Defaults to the two prod
# domains + localhost if not set.
ALLOWED_ORIGINS=https://fiforesight.duckdns.org,https://fiforesight-preview.duckdns.org,http://localhost:3000

# --- Rate limiting ---
# All limits use the slowapi sliding-window format: "N/period"
# where period is second | minute | hour | day | month | year.
RATE_LIMIT_PREDICT_AUTH=10/minute  # per user (or per IP for anonymous callers)
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_JURY=10/minute
RATE_LIMIT_TRADE=15/minute
RATE_LIMIT_BACKTEST=5/minute
RATE_LIMIT_READONLY=60/minute      # DCF, options, earnings, IPO, sectors, briefing, orderbook

# --- Redis cache (optional) ---
UPSTASH_REDIS_URL=

PORT=8000
