# FiForesight backend environment variables
# Copy to backend/.env and fill in the values you need.

# --- LLM Analyst Jury (required for jury verdicts) ---
GROQ_API_KEY=

# --- InfluxDB (OHLCV cache / simulation state) ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=WeekendDevelopment
INFLUXDB_BUCKET=FiForesightBucket

# --- News / sentiment (optional) ---
SERP_API_KEY=
FINNHUB_API_KEY=

# --- IPO calendar (optional) ---
# The IPO Tracker works with NO key: it uses the free Nasdaq IPO calendar
# (upcoming + recent, with price range / shares / market value), falling back to
# the keyless SEC EDGAR S-1 feed if Nasdaq is unreachable.
# NOTE: FMP retired its free IPO calendar on 2025-08-31 (now a PAID endpoint).
# Set a *paid* FMP key here only if you want FMP as the primary source; any FMP
# failure degrades to Nasdaq, then EDGAR.
FMP_API_KEY=
# StockTwits social sentiment. The public API now returns 403 without auth, so
# this is OFF by default — leave unset unless you wire up an authenticated source.
STOCKTWITS_ENABLED=false

# --- Order Book / Market Depth ---
# Crypto pairs (e.g. BTC-USD) return genuine Level-2 depth from Coinbase's
# free public API — no key required, works out of the box.
#
# Stocks (e.g. NVDA) use Alpaca's free IEX top-of-book (Level 1). This needs a
# free API key (the plain Key ID + Secret from the dashboard — NOT OAuth).
# Create a free account at https://alpaca.markets, then under Paper Trading →
# "API Keys" generate a key. When unset, GET /orderbook/{stock} returns 503,
# but crypto pairs still work.
# Key ID from app.alpaca.markets (paper trading)
ALPACA_API_KEY=
# Secret key from app.alpaca.markets (paper trading)
ALPACA_SECRET_KEY=

# --- Auth (optional) ---
SUPABASE_JWT_SECRET=

# --- Redis cache (optional) ---
UPSTASH_REDIS_URL=

PORT=8000
