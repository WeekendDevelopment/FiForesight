# FiForesight backend environment variables
# Copy to backend/.env and fill in the values you need.

# --- LLM Analyst Jury (required for jury verdicts) ---
GROQ_API_KEY=

# --- InfluxDB (OHLCV cache / simulation state) ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=WeekendDevelopment
INFLUXDB_BUCKET=FiForesightBucket

# --- News / sentiment (optional) ---
SERP_API_KEY=
FINNHUB_API_KEY=

# --- Level 2 Order Book (Alpaca Markets — free paper trading) ---
# Create a free paper-trading account at https://alpaca.markets and paste the
# paper-trading API key + secret here. When unset, GET /orderbook/{symbol}
# returns HTTP 503.
ALPACA_API_KEY=        # Paper trading key from alpaca.markets
ALPACA_SECRET_KEY=     # Paper trading secret from alpaca.markets

# --- Auth (optional) ---
SUPABASE_JWT_SECRET=

# --- Redis cache (optional) ---
UPSTASH_REDIS_URL=

PORT=8000
