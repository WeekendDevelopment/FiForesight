{
  "version": "0.0.1",
  "autoPort": true,
  "configurations": [
    {
      "name": "FiForesight (Full Stack)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "app:dev"],
      "port": 3000
    },
    {
      "name": "Frontend (Next.js)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "Frontend (prod)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "run", "start"],
      "port": 3000
    },
    {
      "name": "Backend (FastAPI)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["start_backend.js"],
      "port": 8000
    }
  ]
}
